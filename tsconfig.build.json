{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**", "src/**/__typecheck__/**", "tests", "type-tests", "benchmarks"]
}
